server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" always;

  # Angular only ever talks to /api: the backend is an implementation detail behind this boundary.
  # ${API_UPSTREAM} is substituted from the environment at container start (nginx image templates).
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Correlation-ID $http_x_correlation_id;
    proxy_set_header Authorization $http_authorization;
  }
  # Missing static assets must 404, not fall back to index.html (hides broken deploys).
  location ~* \.(js|css|map|ico|png|svg|woff2?)$ { try_files $uri =404; }
  location / { try_files $uri $uri/ /index.html; }
}
