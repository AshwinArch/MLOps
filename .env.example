# Copy to .env. Never commit real secrets.
POSTGRES_USER=mlops
POSTGRES_PASSWORD=          # set a strong value; required by docker compose
POSTGRES_DB=mlops
# Secure defaults are DEFAULT_ROLE=viewer, SEED_ON_STARTUP=false, ENABLE_FAILURE_SIMULATION=false.
# REQUIRE_FOUR_EYES=true   # default in code; compose sets false for the single-person demo
# REQUIRE_ARTIFACT_CHECKSUM=true   # default: production deploys need an artifact checksum the runtime verifies
# For local demos only, uncomment:
# DEFAULT_ROLE=admin
# SEED_ON_STARTUP=true
# ENABLE_FAILURE_SIMULATION=true
LOG_LEVEL=INFO

# --- production (see docs/adr/ADR-005): ENVIRONMENT=production refuses to start with demo settings ---
# ENVIRONMENT=production
# AUTH_MODE=jwt
# JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json   (or JWT_SECRET for HS256)
# JWT_ISSUER=https://idp.example.com/
# JWT_AUDIENCE=mlops-api
# RUNTIME_ADAPTER=http
# RUNTIME_HTTP_URL=https://runtime.internal.example.com
# METRICS_TOKEN=change-me
